# Copy this file to .env for local dev (vercel dev reads .env automatically),
# and set the same names/values in Vercel's dashboard for the deployed site.
# Never commit the real .env file, and never paste these values into chat.

# Supabase project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-secret-here

# Fintoc dashboard -> API keys (use the pk_test_/sk_test_ pair until you are ready for real banks)
FINTOC_SECRET_KEY=paste-your-fintoc-test-secret-key-here

# aistudio.google.com/apikey -> Create API key (free tier, no card needed).
# Powers the "scan receipt" feature (reads a photo of a boleta and returns
# amount/merchant/date). Leave unset and that feature replies "not
# configured" without breaking anything else.
GEMINI_API_KEY=paste-your-gemini-api-key-here

# Allowed origin for CORS: the URL your Finsy PWA is served from
# (e.g. https://your-site.netlify.app). Use * only while testing locally.
ALLOWED_ORIGIN=*
